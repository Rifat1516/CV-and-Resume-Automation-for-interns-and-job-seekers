<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.cvmatcher.ui.UserManagementController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Registered users" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="Visible to admin only." style="-fx-font-size: 12px;"/>
    <TableView fx:id="userTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="fullNameColumn" text="Full name" prefWidth="160"/>
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="110"/>
            <TableColumn fx:id="ageColumn" text="Age" prefWidth="60"/>
            <TableColumn fx:id="cityColumn" text="City" prefWidth="110"/>
            <TableColumn fx:id="roleColumn" text="Role" prefWidth="70"/>
        </columns>
    </TableView>
    <Button text="Back" onAction="#onBack" maxWidth="120"/>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
