<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.cvmatcher.ui.UserSignupController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    <Label text="Sign up" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <TextField fx:id="nameField" promptText="Full name" maxWidth="260"/>
    <TextField fx:id="phoneField" promptText="Phone number" maxWidth="260"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="260"/>
    <Button text="Create account" onAction="#onSignUp" maxWidth="200"/>
    <Button text="Back" onAction="#onBack" maxWidth="120"/>
    <Label fx:id="statusLabel" textFill="RED" wrapText="true"/>
</VBox>
