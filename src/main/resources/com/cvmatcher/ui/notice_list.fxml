<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.cvmatcher.ui.NoticeListController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Job notices" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TableView fx:id="noticeTable" prefHeight="260">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="40"/>
            <TableColumn fx:id="companyColumn" text="Company" prefWidth="130"/>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="150"/>
            <TableColumn fx:id="locationColumn" text="Location" prefWidth="90"/>
            <TableColumn fx:id="availabilityColumn" text="Available / Total" prefWidth="110"/>
            <TableColumn fx:id="stateColumn" text="State" prefWidth="100"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <TextField fx:id="rankIdsField" promptText="Notice IDs to rank, e.g. 1, 2, 3" prefWidth="220"/>
        <Button text="Rank selected" onAction="#onRankSelected"/>
    </HBox>
    <HBox spacing="8">
        <Button text="Edit availability (admin)" onAction="#onEditAvailability"/>
        <Button text="Edit description (admin)" onAction="#onEditDescription"/>
    </HBox>
    <Button text="Back" onAction="#onBack" maxWidth="120"/>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
