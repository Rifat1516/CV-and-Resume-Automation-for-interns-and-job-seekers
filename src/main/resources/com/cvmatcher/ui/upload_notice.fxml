<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cvmatcher.ui.UploadNoticeController">
    <VBox spacing="10">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        <Label text="Upload job notice" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <TextField fx:id="companyField" promptText="Company" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="titleField" promptText="Job title" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <TextField fx:id="locationField" promptText="Location (e.g. Dhaka)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="salaryField" promptText="Salary (e.g. Negotiable, 45,000-55,000 BDT)" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <TextField fx:id="experienceField" promptText="Experience required (e.g. 4+ Years)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="totalPositionsField" promptText="Number of vacancies" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <TextField fx:id="deadlineField" promptText="Application deadline (e.g. 31 August, 2026)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="contactEmailField" promptText="Contact email" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <Label text="Responsibilities (one per line)"/>
        <TextArea fx:id="responsibilitiesArea" prefRowCount="4" wrapText="true"
                  promptText="Design, develop, and maintain...&#10;Build responsive user interfaces using..."/>

        <Label text="Requirements / qualifications (one per line)"/>
        <TextArea fx:id="requirementsArea" prefRowCount="4" wrapText="true"
                  promptText="BSc/MSc from a reputed university&#10;3 to 5 years of relevant experience"/>

        <Label text="Additional notes (optional)"/>
        <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true"/>

        <Button text="Submit" onAction="#onSubmit"/>
        <Button text="Back" onAction="#onBack" maxWidth="120"/>
        <Label fx:id="statusLabel" wrapText="true"/>
    </VBox>
</ScrollPane>
