<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.cvmatcher.ui.JobPositionsController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Job position availability" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="Viewable by everyone. Adding or editing positions is admin-only." style="-fx-font-size: 11px; -fx-text-fill: gray;"/>

    <Label text="Available positions" style="-fx-font-weight: bold;"/>
    <TableView fx:id="availableTable" prefHeight="150">
        <columns>
            <TableColumn fx:id="availRoleColumn" text="Role" prefWidth="160"/>
            <TableColumn fx:id="availCompanyColumn" text="Company" prefWidth="140"/>
            <TableColumn fx:id="availTitleColumn" text="Notice title" prefWidth="160"/>
            <TableColumn fx:id="availCountColumn" text="Availability" prefWidth="160"/>
        </columns>
    </TableView>

    <Label text="Unavailable positions" style="-fx-font-weight: bold;"/>
    <TableView fx:id="unavailableTable" prefHeight="150">
        <columns>
            <TableColumn fx:id="unavailRoleColumn" text="Role" prefWidth="160"/>
            <TableColumn fx:id="unavailCompanyColumn" text="Company" prefWidth="140"/>
            <TableColumn fx:id="unavailTitleColumn" text="Notice title" prefWidth="160"/>
            <TableColumn fx:id="unavailCountColumn" text="Availability" prefWidth="160"/>
        </columns>
    </TableView>

    <HBox spacing="8">
        <ComboBox fx:id="noticeComboBox" promptText="Select job notice" prefWidth="220"/>
        <TextField fx:id="roleNameField" promptText="Role name (e.g. AI Engineer)" prefWidth="160"/>
        <TextField fx:id="totalCountField" promptText="Total count" prefWidth="90"/>
        <Button fx:id="addPositionButton" text="Add position (admin)" onAction="#onAddPosition"/>
    </HBox>
    <HBox spacing="8">
        <Button fx:id="editFilledCountButton" text="Edit filled count (admin)" onAction="#onEditFilledCount"/>
        <Button text="Back" onAction="#onBack"/>
    </HBox>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
